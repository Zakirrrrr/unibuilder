APP_NAME=University Visual Profile API
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=false
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
WIKIDATA_TIMEOUT_SECONDS=8.0
WIKIDATA_SEARCH_LIMIT=10
WIKIDATA_MAXLAG_SECONDS=10
WIKIDATA_USER_AGENT=UniversityVisualProfileMVP/0.1 (hackathon backend; contact: local-development)
WIKIMEDIA_COMMONS_API_URL=https://commons.wikimedia.org/w/api.php
WIKIMEDIA_TIMEOUT_SECONDS=10.0
WIKIMEDIA_MAXLAG_SECONDS=10
WIKIMEDIA_RETRY_ATTEMPTS=3
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=10.0
IMAGE_DOWNLOAD_MAX_BYTES=15000000
PERCEPTUAL_HASH_THRESHOLD=2
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=30.0
AI_RETRY_ATTEMPTS=3
AI_REQUESTS_PER_MINUTE=30
GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=
PROFILE_TIMEOUT_SECONDS=29.0
PROFILE_CACHE_TTL_SECONDS=900.0
PROFILE_LIMIT_PER_QUERY=6
PROFILE_AI_CONCURRENCY=6
## Google Images search via SerpAPI (separate from Gemini key)
SERPAPI_API_KEY=
